# ==============================================================================
# ArtXFlow Environment Configuration Template
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Database (PostgreSQL / Neon)
# e.g. postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/artxflow?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/artxflow"

# Authentication (Better Auth)
# Generate with `openssl rand -base64 32` (minimum 32 characters)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth Providers (Optional in local development)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional Email Provider (Brevo)
# Optional in local development (falls back to console email logging)
BREVO_API_KEY=""
BREVO_FROM_EMAIL="noreply@artxflow.com"
BREVO_FROM_NAME="ArtXFlow"

# Encryption (Platform credentials encryption key)
# 32-character or 64-character hex key for AES-256-GCM
ENCRYPTION_KEY="change-this-to-a-secure-32-char-key-for-encryption"

# Inngest (Workflow orchestration)
# Local development can run with Inngest Dev Server without production keys
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Cloudflare R2 Asset Storage (Optional - falls back to local disk storage if omitted)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Unsplash API (Optional - enables instant cover image search in editor)
# Obtain free developer key at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

# Public Application URL (Client-safe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
